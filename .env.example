# OpenRouter (modèle de vision)
OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_MAX_TOKENS=1024

# Mailtrap
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
EMAIL_FROM=noreply@example.com

# KYC Callback
KYC_CALLBACK_URL=http://your-service/kyc/callback
KYC_CALLBACK_TOKEN=your_callback_token
KYC_CALLBACK_TIMEOUT=10

# InsightFace
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_THRESHOLD=0.40
INSIGHTFACE_CTX_ID=-1

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://domainename.com

# Debug
DEBUG=False

# JWT (JWT_EXPIRE_MINUTES=False pour désactiver l'expiration)
JWT_SECRET_KEY=your_jwt_secret_key
JWT_EXPIRE_MINUTES=60
